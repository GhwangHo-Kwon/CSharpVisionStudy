<Window x:Class="VisionStudy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Inspection Study"
        Width="1000"
        Height="650">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 이미지 불러오기 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="이미지 불러오기"
                    Width="130"
                    Height="35"
                    Click="LoadImage_Click"/>

            <TextBlock x:Name="FileNameText"
                       Text="이미지를 선택해주세요."
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Threshold 설정 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Threshold"
                       VerticalAlignment="Center"/>

            <Slider x:Name="ThresholdSlider"
                    Width="300"
                    Minimum="0"
                    Maximum="255"
                    Value="150"
                    Margin="15,0"
                    ValueChanged="ThresholdSlider_ValueChanged"/>

            <TextBlock x:Name="ThresholdText"
                       Text="150"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 이미지 출력 영역 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="원본 이미지"
                      Margin="0,0,5,0">

                <Image x:Name="OriginalImage"
                       Stretch="Uniform"/>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Threshold 결과"
                      Margin="5,0,0,0">

                <Image x:Name="ProcessedImage"
                       Stretch="Uniform"/>
            </GroupBox>
        </Grid>

        <!-- 검사 결과 -->
        <TextBlock Grid.Row="3"
                   x:Name="ResultText"
                   Text="검사 대기 중"
                   FontSize="17"
                   FontWeight="Bold"
                   Margin="0,15,0,0"/>

    </Grid>
</Window>
